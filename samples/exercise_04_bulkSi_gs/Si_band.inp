!########################################################################################!
! Band-structure calculation for crystalline silicon (run AFTER the ground state).        !
!----------------------------------------------------------------------------------------!
! Prerequisite: first converge the ground state with Si_gs.inp (theory='dft'), which     !
! writes the restart directory 'data_for_restart'. theory='dft_band' restarts from that  !
! density and diagonalizes H at the k-points along the high-symmetry path below, writing  !
! the eigenvalues to 'band.dat'.                                                          !
!                                                                                         !
!   salmon < Si_gs.inp     # ground state  -> data_for_restart/                           !
!   ln -s data_for_restart restart    # restart dir is read from ./restart                !
!   salmon < Si_band.inp   # band structure -> band.dat                                   !
!########################################################################################!

&calculation
  theory = 'dft_band'
/

&control
  sysname = 'Si'
  yn_restart = 'y'
/

&units
  unit_system = 'A_eV_fs'
/

&system
  yn_periodic = 'y'
  al(1:3) = 5.43d0, 5.43d0, 5.43d0
  nelem  = 1
  natom  = 8
  nelec  = 32
  nstate = 32
/

&pseudo
  file_pseudo(1) = './Si_rps.dat'
  izatom(1) = 14
  lloc_ps(1) = 2
/

&functional
  xc = 'PZ'
/

&rgrid
  num_rgrid(1:3) = 12, 12, 12
/

&kgrid
  num_kgrid(1:3) = 4, 4, 4
/

&scf
  nscf      = 100
  threshold = 1.0d-9
/

&band
  !--- explicit high-symmetry path (lattice='non' => use kpt/ndiv_segment below) ---!
  lattice = 'non'
  nref_band = 20                       ! converge eigenvalues up to this band index
  tol_esp_diff = 1.0d-5                ! per-band convergence tol on |dE| (a.u.)
  num_of_segments = 4                  ! L-G-X-M-G : 4 segments, 5 end points
  ndiv_segment(1:4) = 16, 16, 16, 16   ! k-points per segment
  kpt(1:3,1) = 0.5d0, 0.5d0, 0.5d0     ! L  (reduced reciprocal coordinates)
  kpt(1:3,2) = 0.0d0, 0.0d0, 0.0d0     ! G
  kpt(1:3,3) = 0.5d0, 0.0d0, 0.0d0     ! X
  kpt(1:3,4) = 0.5d0, 0.5d0, 0.0d0     ! M
  kpt(1:3,5) = 0.0d0, 0.0d0, 0.0d0     ! G
  kpt_label(1) = 'L'
  kpt_label(2) = 'G'
  kpt_label(3) = 'X'
  kpt_label(4) = 'M'
  kpt_label(5) = 'G'
/

&atomic_red_coor
  'Si'	.0	.0	.0	1
  'Si'	.25	.25	.25	1
  'Si'	.5	.0	.5	1
  'Si'	.0	.5	.5	1
  'Si'	.5	.5	.0	1
  'Si'	.75	.25	.75	1
  'Si'	.25	.75	.75	1
  'Si'	.75	.75	.25	1
/
