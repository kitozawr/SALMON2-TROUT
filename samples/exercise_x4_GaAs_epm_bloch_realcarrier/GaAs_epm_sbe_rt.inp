!########################################################################################!
! GaAs SBE real-time run on the EPM ground state -- REAL-carrier maps + intra-band current.!
!----------------------------------------------------------------------------------------!
! Step 2 of 2. Reads the GaAs_epm_*.data files written by GaAs_epm_gs.inp (sysname, al,    !
! num_kgrid, nstate, nelec MUST match). Plain velocity-gauge SBE (all dissipation OFF):   !
! a clean CF4/Yoshida/Strang propagation, which is all that is needed to look at the      !
! field-driven carrier population. The pulse below is z-polarized, below the 2.5 eV gap,  !
! and runs PAST the pulse so the real-carrier maps settle to their field-free residual.   !
!----------------------------------------------------------------------------------------!
! Units a.u.:  Length 1 [a.u.] = 0.52917721067 [Angstrom];  Energy 1 [a.u.] = 27.2114 eV  !
!########################################################################################!

&calculation
    theory = 'sbe'
/

&control
    sysname = 'GaAs_epm'                   ! reads GaAs_epm_k.data / _eigen.data / _tm.data
/

&units
    unit_system = 'au'
/

&system
    yn_periodic = 'y'
    al(1:3) = 10.68d0, 10.68d0, 10.68d0
    nelec  = 32
    nstate = 32
/

&kgrid
    num_kgrid(1:3) = 4, 4, 4
/

&tgrid
    dt = 0.08d0
    nt = 700                                ! runs to t = 56 a.u., well past the pulse
/

&emfield
    ae_shape1      = 'Acos2'
    epdir_re1(1:3) = 0.0d0, 0.0d0, 1.0d0    ! field || z
    I_wcm2_1       = 1.0d+11
    tw1            = 20.0d0                  ! pulse essentially over by t ~ 20 a.u.
    omega1         = 0.06d0                  ! 1.63 eV, below the 2.5 eV gap
/

&analysis
    out_projection_step      = 20           ! n_ex(t) cadence
    out_projection_k_step    = 70           ! per-k population maps (a handful of frames)
    yn_out_intraband_current = 'y'          ! Houston intra-band (drift) current
/

&sbe
    ! all yn_sbe_* default OFF -> plain (dissipation-free) dynamics
/
