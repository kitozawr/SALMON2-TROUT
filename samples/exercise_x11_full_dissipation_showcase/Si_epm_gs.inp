!########################################################################################!
! Si PRIMITIVE-CELL EPM ground state -- in-SALMON Fortran EPM (theory='epm').              !
!----------------------------------------------------------------------------------------!
! Step 1 of 2. Writes Si_prim_k/_eigen/_tm.data read by Si_prim_sbe_rt.inp (step 2).       !
! Diamond (V^A = 0), Kunikiyo form factors, FCC 2-atom primitive cell. Verified            !
! INTERCHANGEABLE with epm_si_primitive.py (band energies to 5e-11 Ha).                    !
! NOTE the cutoff is RAISED to 27 Ry: the Si Delta-valley camel-back needs it to land the  !
! CBM at 0.85*X (11.1 Ry mislands it). The cutoff only sizes the GS basis, not the SBE.    !
!----------------------------------------------------------------------------------------!
! Units a.u.:  Length 1 [a.u.] = 0.52917721067 [Angstrom];  Energy 1 [a.u.] = 27.2114 eV   !
!########################################################################################!

&calculation
    theory = 'epm'
/

&control
    sysname = 'Si_prim'
/

&units
    unit_system = 'A_eV_fs'
/

&system
    yn_periodic = 'y'
    al(1:3) = 5.42935818d0, 5.42935818d0, 5.42935818d0       ! Si a = 5.431 Angstrom
    nelec  = 8                                 ! 2 atoms x 4 valence e- -> 8 -> 4 filled bands
    nstate = 8
/

&kgrid
    num_kgrid(1:3) = 8, 8, 8
/

&epm
    epm_material            = 'Si'             ! diamond, V^A = 0, Kunikiyo FFs (gap ~1.06 eV converged)
    epm_lattice_constant_au = 10.26d0
    epm_pw_cutoff_ry        = 27.0d0           ! RAISED for the Si camel-back (CBM at 0.85*X)
    epm_cell                = 'primitive'
/
