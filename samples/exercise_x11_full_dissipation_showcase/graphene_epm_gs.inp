!########################################################################################!
! graphene PRIMITIVE-CELL EPM ground state -- in-SALMON Fortran EPM (theory='epm').        !
!----------------------------------------------------------------------------------------!
! Step 1 of 2. Writes graphene_prim_k/_eigen/_tm.data read by graphene_prim_sbe_rt.inp.    !
! 2-atom HEXAGONAL primitive (non-orthogonal, 2D-in-vacuum, NO folding), minimal Ramanujam !
! pi-EPM (3 form factors). Verified INTERCHANGEABLE with epm_graphene_primitive.py (band   !
! energies to ~6e-8 eV). The Dirac cone is gapless at K (symmetry-protected).              !
!                                                                                          !
! IMPORTANT for graphene:                                                                  !
!  * the in-plane lattice constant is FIXED at the cited 2.46 Ang (the EPM ignores         !
!    epm_lattice_constant_au for graphene -- it would otherwise inherit the GaAs default). !
!  * epm_pw_cutoff_ry is a KINETIC cutoff here (|G|^2 [a.u.] <= cutoff). 29.4 (43 plane      !
!    waves, shell-complete) -- NOT the earlier 2.94 (7 PW): that basis is not closed under   !
!    the little group of K and opens a SPURIOUS 0.21 eV gap at the Dirac point (x14 finding, !
!    tests/test_graphene_dirac_levels.py). 43 PW: gap 7e-6 eV, v_F = 0.96e6 m/s (thesis).     !
!  * num_kgrid z = 1 (no dispersion along the vacuum axis); use a multiple of 3 in-plane   !
!    so the K=(2/3,1/3) Dirac point is near the mesh. nelec=2, nstate=2 (the pi/pi* pair). !
!----------------------------------------------------------------------------------------!
! Units a.u.:  Length 1 [a.u.] = 0.52917721067 [Angstrom];  Energy 1 [a.u.] = 27.2114 eV   !
!########################################################################################!

&calculation
    theory = 'epm'
/

&control
    sysname = 'graphene_prim'
/

&units
    unit_system = 'A_eV_fs'
/

&system
    yn_periodic = 'y'
    al(1:3) = 2.46000197d0, 2.46000197d0, 19.99999867d0   ! a = 2.46 Ang, 20 Ang vacuum (informational; EPM fixes a)
    nelec  = 2                                     ! 2 atoms x 1 pi e- -> 1 filled valence pi band
    nstate = 2                                     ! pi (valence) + pi* (conduction): the Dirac pair
/

&kgrid
    num_kgrid(1:3) = 12, 12, 1                     ! multiple of 3; z=1 (no kz dispersion)
/

&epm
    epm_material     = 'graphene'                  ! honeycomb, V^A = 0, Ramanujam 3-form-factor pi-model
    epm_pw_cutoff_ry = 29.4d0                      ! |G|^2 <= 29.4 a.u.: 43 PW, gapless K (2.94 = 7 PW is GAPPED, see header)
    epm_cell         = 'primitive'                 ! the only graphene mode (gapless Dirac, no folding)
/
