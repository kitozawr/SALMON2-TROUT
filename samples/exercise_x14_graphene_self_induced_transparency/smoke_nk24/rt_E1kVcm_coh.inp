!########################################################################################!
! x14 graphene self-induced transparency -- coh  variant, peak E = 1 kV/cm                 !
!----------------------------------------------------------------------------------------!
! In-plane (x) Acos2 pulse, hbar*omega = 0.800 eV, 8.0 cycles (tw) + 60.0 fs tail.        !
! I = 1.327e+03 W/cm^2, A0 = E0/omega = 6.61e-06 a.u. (k excursion), Rabi area ~ 0.00 rad.   !
! Field before = E_ext column, field after = sheet BC on the Jm column: transmission.py.  !
! Compare coh / diss / mem at the same field: the memory+dressed-reference variant is the one whose ring sees only REAL carriers (wiki/10 sec. 8.11).   
!########################################################################################!

&calculation
  theory = 'sbe'
/

&control
  sysname = 'graphene_sit'
/

&units
  unit_system = 'au'
/

&system
  yn_periodic  = 'y'
  al_vec1(1:3) = 4.648726d0, 0.0d0, 0.0d0
  al_vec2(1:3) = 2.324363d0, 4.025915d0, 0.0d0
  al_vec3(1:3) = 0.0d0, 0.0d0, 37.794523d0          ! 20 Ang vacuum: L_z of the sheet cell
  nelec  = 2
  nstate = 2
/

&kgrid
  num_kgrid(1:3) = 24, 24, 1
/

&tgrid
  dt = 4.0000d0
  nt = 1048
/

&emfield
  ae_shape1      = 'Acos2'
  epdir_re1(1:3) = 1.0d0, 0.0d0, 0.0d0
  E_amplitude1   = 1.944690e-07
  tw1            = 1709.742d0
  omega1         = 0.02939946d0
/

&analysis
  out_projection_k_step = 1048
/

&epm
  epm_material = 'graphene'
/

&sbe
  ! coherent SBE only: Pauli-blocking / Rabi bleaching baseline (no ring)
/
