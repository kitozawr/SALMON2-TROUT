!########################################################################################!
! Si PRIMITIVE-CELL EPM ground state (step 1/2, FULL-DISSIPATION template) -- in-SALMON Fortran EPM, theory='epm'.    !
!----------------------------------------------------------------------------------------!
! Diamond (V^A=0), Kunikiyo form factors, FCC 2-atom primitive cell, NO folding. Verified  !
! interchangeable with epm_si_primitive.py (band energies to 5e-11 Ha). Writes             !
! Si_prim_k/_eigen/_tm.data read by Si_prim_sbe_rt.inp.                                     !
!                                                                                          !
! NSTATE = 20 (4 valence + 16 conduction): DELIBERATE velocity-gauge headroom. The number  !
! of conduction bands sets the VG-basis sufficiency -- too few and a strong field drives    !
! carriers past the top band (see the README "basis sufficiency" check). Cutoff RAISED to   !
! 27 Ry so the Si Delta-valley camel-back lands the CBM at 0.85*X (11.1 Ry mislands it);    !
! the cutoff sizes the GS basis only, not the SBE band count.                               !
!----------------------------------------------------------------------------------------!
! Units a.u.:  Length 1 = 0.52917721067 Angstrom;  Energy 1 = 27.2114 eV.                   !
!########################################################################################!

&calculation
    theory = 'epm'
/

&control
    sysname = 'Si_prim'
/

&units
    unit_system = 'au'
/

&system
    yn_periodic = 'y'
    al(1:3) = 10.26d0, 10.26d0, 10.26d0        ! Si a = 5.431 Angstrom
    nelec  = 8                                  ! 2 atoms x 4 valence e- -> 4 filled bands
    nstate = 20                                 ! 4 valence + 16 conduction (VG headroom)
/

&kgrid
    num_kgrid(1:3) = 8, 8, 8                    ! ring channels are O(nk^2..3): 8^3 default (x8 uses 16^3, dissipation-free)
/

&epm
    epm_material            = 'Si'              ! diamond, Kunikiyo FFs (indirect gap ~1.06 eV)
    epm_lattice_constant_au = 10.26d0
    epm_pw_cutoff_ry        = 27.0d0            ! Si camel-back: CBM at 0.85*X
    epm_cell                = 'primitive'       ! FCC 2-atom, non-orthogonal, NO folding
/
