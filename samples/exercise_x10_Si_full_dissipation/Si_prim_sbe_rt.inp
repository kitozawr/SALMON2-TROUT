!########################################################################################!
! Si PRIMITIVE-CELL SBE real-time with ALL DISSIPATION CHANNELS (step 2/2).              !
!----------------------------------------------------------------------------------------!
! Template for open-system runs (e.g. the long bleaching experiment): otherwise a copy   !
! of exercise_x8 (same cell, same field files, same HHG tooling), but every dissipation  !
! channel is ON and rides the nonlocal ring:                                             !
!                                                                                        !
!   yn_sbe_superres          ring / super-mode: makes e-ph and II momentum-resolved      !
!                            INTER-k (Si e-ph is all-intervalley -> needs the ring)      !
!   yn_sbe_eph               e-ph Lindblad (Si: 6 intervalley g/f modes, cited)          !
!   yn_sbe_impact_ionization nonlocal II, crystal-momentum conserving on the ring        !
!   yn_sbe_auger             ring Auger = exact time-reverse of the II (detailed         !
!                            balance -> NO separate C needed; REQUIRES the II channel)   !
!   yn_sbe_eeh               carrier-carrier (e-e/e-h) FD thermalization (cited Si rate) !
!   sbe_decoh_*              Kuhn-Zurek gauge-covariant decoherence (phenomenological    !
!                            dephasing; set either parameter <= 0 to disable)            !
!   yn_sbe_bgr_threshold     density-dependent II threshold (BGR). MUTUALLY EXCLUSIVE    !
!                            with yn_sbe_coulomb (gap double-count guard): Sigma^HF off  !
!                            -> BGR is the stand-in. To use Coulomb HF instead, set      !
!                            yn_sbe_coulomb='y' AND yn_sbe_bgr_threshold='n'.            !
!                                                                                        !
! COST: the ring II/Auger pair is O(nk^3)/step -- fine at 4^3..8^3, prohibitive ~20^3.   !
! The 8^3 default matches the validated Si ring runs; drop to 4^3 for a fast smoke test, !
! raise nt for production. Electron number must stay 8.000 at every step (CPTP).         !
!                                                                                        !
!   ../../build/salmon < Si_prim_epm_gs.inp     # step 1/2 (8^3 grid)                    !
!   ../../build/salmon < Si_prim_sbe_rt.inp | tee sbe_rt.out                             !
!   python3 ../../plot_sbe_results.py -i . -o plots --spectral --valleys                 !
!   python3 hhg_spectrum.py                     # HHG spectrum (same tooling as x8)      !
!                                                                                        !
! FIELD FILES (A/eV/fs; col1 = time[fs], cols2-4 = Ax,Ay,Az) -- the x8 amplitude ladder: !
!   100.txt A_max=2.76 / 10.txt 0.28 (default) / 1.txt 0.028 / 0.1.txt 0.0028            !
!########################################################################################!

&calculation
  theory = 'sbe'
/

&control
  sysname = 'Si_prim'
/

&units
  unit_system = 'A_eV_fs'
/

&system
  yn_periodic  = 'y'
  al_vec1(1:3) = 0.0000000d0, 2.7146791d0, 2.7146791d0   ! Si FCC primitive a/2 = 5.13 Bohr (a=10.26)
  al_vec2(1:3) = 2.7146791d0, 0.0000000d0, 2.7146791d0
  al_vec3(1:3) = 2.7146791d0, 2.7146791d0, 0.0000000d0
  nelec  = 8
  ! nb (BAND BUDGET): MUST match the GS step. 20 = 4 valence + 16 conduction of
  ! VG headroom, enough for a weak/moderate THz field. A STRONGER field pushes
  ! population higher -> raise nstate (1 MV/cm ~ 24-32, >=3 MV/cm ~ 40-48) and
  ! re-verify P_top < 1e-3 + nex(nstate) plateau (wiki/06 §7). Regenerate the GS
  ! at the same nstate whenever you change it.
  nstate = 20
/

&kgrid
  num_kgrid(1:3) = 8, 8, 8             ! MUST match the GS step; see the COST note above
/

&tgrid
  dt = 0.05d0                          ! STEP: only dt <= 0.05 fs converges the NON-ADIABATIC
                                       ! nex_proj measure; a coarser dt over-generates the
                                       ! dressed population (dt-artifact, wiki/06 §6). Converge
                                       ! dt on nex_proj, NOT the diabatic nelec (which hides it).
                                       ! 0.25 fs is OK for current-only observables.
  nt = 1200                            ! 60 fs template. For a long (ps) field, run only PART of
                                       ! it -- 0.05 fs x full ps = 1e4+ steps (cluster job).
/

&emfield
  ae_shape1   = 'input'
  file_input1 = '10.txt'               ! A_max=0.28 along z (see the amplitude ladder above)
/

&analysis
  out_projection_k_step    = 100       ! k-resolved population snapshots
  yn_out_intraband_current = 'y'       ! Houston intra-band (drift) current -> Drude/bleaching
/

&epm
  epm_material = 'Si'                  ! sizes the dissipation constants (registry: cited Si values)
/

&sbe
  ! --- ALL dissipation channels ON (see the header for what each one is) ---
  yn_sbe_superres          = 'y'       ! ring: inter-k e-ph + momentum-conserving II/Auger
  yn_sbe_eph               = 'y'       ! Si 6 intervalley g/f phonon modes
  yn_sbe_impact_ionization = 'y'       ! nonlocal II (ring)
  yn_sbe_auger             = 'y'       ! ring Auger (detailed-balance partner of the II)
  yn_sbe_eeh               = 'y'       ! carrier-carrier FD thermalization
  sbe_decoh_temperature_k  = 300.0d0   ! Kuhn-Zurek dephasing at 300 K ...
  sbe_decoh_tau_m_fs       = 30.0d0    ! ... with tau_m = 30 fs (both <= 0 to disable)
  yn_sbe_bgr_threshold     = 'y'       ! BGR threshold shift (Coulomb HF is OFF below)
  yn_sbe_coulomb           = 'n'       ! Sigma^HF mean-field: if 'y', MUST set bgr='n' (guard aborts)
  ! --- MASK (cost-preserving frozen window) --------------------------------
  yn_sbe_full_dressed      = 'y'       ! full-basis dressed projection = CORRECT (default). The
                                       ! dissipators/measure use ALL nstate bands, so a narrow
                                       ! window below does NOT truncate the physics -- it only
                                       ! skips dissipator SOURCES outside the window (e-ph AND
                                       ! the 2-particle II/Auger), restoring O(nk^2*n_active) cost
                                       ! (wiki/11 §3d: measured 1.4-1.8x, nex within ~0-14%).
  frozen_core_threshold_ev = -100.0d0  ! active window = [Fermi+core, Fermi+free] eV. Defaults
  frozen_free_threshold_ev =  100.0d0  ! (-100/+100) freeze nothing (all-active). Narrow to e.g.
                                       ! -10/+10 to engage the mask; WIDEN for stronger fields
                                       ! (a too-tight window drops real II sources -- wiki/06 §7).
/
