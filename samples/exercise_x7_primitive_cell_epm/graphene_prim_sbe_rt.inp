!########################################################################################!
! graphene PRIMITIVE-CELL SBE — 2-atom HEXAGONAL, 2D-in-vacuum, NO folding (minimal pi).  !
!----------------------------------------------------------------------------------------!
! Generate the GS first:                                                                  !
!   python3 -c "import epm_graphene_primitive as g; g.main_gs(); g.main_bandpath()"       !
! 2-atom hexagonal primitive embedded in a 3D box with 20 A of c-axis vacuum; the lattice !
! vectors below are that 3D cell in Bohr. Minimal Ramanujam pi-EPM: the Dirac cone is the !
! lowest band pair, 1 pi e-/atom -> nelec=2 (1 filled valence pi), nstate=2 (pi/pi*).     !
! num_kgrid is a multiple of 3 so the K Dirac point (2/3,1/3) is on the mesh; kz=1 (no    !
! dispersion along vacuum). In-plane field (epdir 1,0,0); graphene is GAPLESS so any      !
! field excites -- carriers populate the six K/K' Dirac corners (see the Cartesian map).  !
!########################################################################################!

&calculation
  theory = 'sbe'
/

&control
  sysname = 'graphene_prim'
/

&units
  unit_system = 'au'
/

&system
  yn_periodic  = 'y'
  al_vec1(1:3) = 4.64873d0, 0.00000d0,  0.00000d0
  al_vec2(1:3) = 2.32436d0, 4.02592d0,  0.00000d0
  al_vec3(1:3) = 0.00000d0, 0.00000d0, 37.79452d0     ! 20 A vacuum
  nelec  = 2
  nstate = 2
/

&kgrid
  num_kgrid(1:3) = 12, 12, 1          ! multiple of 3 -> K on the mesh; 1 along vacuum
/

&tgrid
  dt = 0.2d0
  nt = 3000
/

&emfield
  ae_shape1      = 'Acos2'
  epdir_re1(1:3) = 1.0d0, 0.0d0, 0.0d0    ! in-plane (zigzag x)
  I_wcm2_1       = 1.0d+11
  tw1            = 400.0d0
  omega1         = 0.02d0
/

&analysis
  out_projection_k_step = 1500
/

&sbe
  ! all yn_sbe_* default OFF here -> clean dynamics (trace = 2 conserved).
  !
  ! graphene ELECTRON-PHONON is available (E2g 196 meV + A1' 160 meV, cited
  ! Piscanec 2004) but is RING-ONLY -- both modes relax carriers to a different
  ! k on the Dirac cone, so the k-local same-k search is inert. To enable it add
  ! the &epm block (epm_material='graphene') above AND, in this &sbe block:
  !     yn_sbe_eph            = 'y'
  !     yn_sbe_superres       = 'y'     ! REQUIRED: inter-k e-ph through the ring
  !     sbe_eph_temperature_k = 300.0d0
  ! Validated: electrons=2.000 conserved (CPTP); carriers relax toward the K/K'
  ! Dirac corners.
  !
  ! graphene AUGER / CARRIER MULTIPLICATION (2D Rana [R07], wiki/07 sec.6) is
  ! also available and likewise RING-ONLY:
  !     yn_sbe_auger          = 'y'
  !     yn_sbe_superres       = 'y'     ! REQUIRED (global population gather)
  !     sbe_eph_temperature_k = 300.0d0 ! carrier/bath temperature of the rates
  ! Net CPTP pair relaxation R - G on instantaneous quasi-Fermi levels: above
  ! the 300 K thermal density it RECOMBINES (tau_r ~ ps at 1e12 cm^-2 [R07]),
  ! below it it GENERATES toward equilibrium (detailed balance). eps_r defaults
  ! to the R07 benchmark 10 (substrate-dependent); override: sbe_coulomb_epsilon.
  ! Validated: electrons=2.000 conserved; post-pulse nex decays monotonically.
  !
  ! FORBIDDEN for graphene (gapless): yn_sbe_impact_ionization (the Rana channel
  ! IS the thresholdless CM), yn_sbe_eeh, yn_sbe_coulomb, and Kuhn-Zurek
  ! sbe_decoh_* (all error stop).
/
