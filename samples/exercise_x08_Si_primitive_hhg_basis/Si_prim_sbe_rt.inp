!########################################################################################!
! Si PRIMITIVE-CELL SBE real-time (step 2/2) -- FCC 2-atom, non-orthogonal, NO folding.     !
!----------------------------------------------------------------------------------------!
! Reads Si_prim_k/_eigen/_tm.data from step 1. Drives an input vector-potential pulse       !
! (file_input1) and records the k-resolved REAL-carrier populations + the total and         !
! intra-band currents. Clean velocity-gauge dynamics (no dissipation).                      !
!                                                                                          !
! FIELD FILES (A/eV/fs units; col1=time[fs], cols2-4 = vector potential Ax,Ay,Az):          !
!   100.txt  A_max=2.76   -- OVER-DRIVES the basis (demo the VG overflow, see README)        !
!   10.txt   A_max=0.28   -- clean here (the default below)                                  !
!   1.txt    A_max=0.028  -- weak / perturbative                                             !
!   0.1.txt  A_max=0.0028 -- linear response                                                 !
! Same pulse SHAPE (same frequency); only the amplitude scales -> ideal for the             !
! basis-sufficiency sweep. al_vec below are the Si FCC primitive vectors a/2*(0,1,1) etc.   !
! (a=10.26 Bohr). nelec/nstate/num_kgrid MUST match the GS step.                            !
!########################################################################################!

&calculation
  theory = 'sbe'
/

&control
  sysname = 'Si_prim'
/

&units
  unit_system = 'A_eV_fs'
/

&system
  yn_periodic  = 'y'
  al_vec1(1:3) = 0.0000000d0, 2.7146791d0, 2.7146791d0   ! Si FCC primitive a/2 = 5.13 Bohr = 2.7146791 Ang (a=10.26 Bohr)
  al_vec2(1:3) = 2.7146791d0, 0.0000000d0, 2.7146791d0
  al_vec3(1:3) = 2.7146791d0, 2.7146791d0, 0.0000000d0
  nelec  = 8
  nstate = 20                          ! MUST match the GS (VG headroom: 16 conduction bands)
/

&kgrid
  num_kgrid(1:3) = 16, 16, 16
/

&tgrid
  dt = 0.1d0                           ! fast; reduce (0.02-0.05) for accuracy vs the ~14 eV band spread
  nt = 600                             ! 60 fs (the pulse rises ~45 fs, peaks ~130 fs)
/

&emfield
  ae_shape1   = 'input'                ! read the vector potential A(t) from the file
  file_input1 = '10.txt'               ! <- clean default; set to '100.txt' to SEE the VG overflow
/

&analysis
  out_projection_k_step    = 10        ! k-resolved REAL + Houston population snapshots (every 1 fs)
  yn_out_intraband_current = 'y'       ! Houston intra-band (drift) current for HHG
/

&sbe
  ! all yn_sbe_* default OFF -> clean velocity-gauge dynamics (no dissipation).
/
