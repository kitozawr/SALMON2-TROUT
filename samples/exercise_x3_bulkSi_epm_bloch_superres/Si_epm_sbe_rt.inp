!########################################################################################!
! Silicon SBE real-time run on the EPM ground state, super-compute mode.                  !
!----------------------------------------------------------------------------------------!
! Step 2 of 2. Reads the Si_epm_*.data files written by Si_epm_gs.inp (sysname, al,       !
! num_kgrid, nstate, nelec MUST match). Drives the velocity-gauge SBE with the new        !
! CPTP dissipation channels. Every yn_sbe_* flag defaults OFF; with all of them off this  !
! reduces to the plain CF4/Yoshida/Strang run. Turn channels on one at a time to study    !
! their effect. See wiki/04 "Recipes by material & mode" for the per-channel reference.   !
!----------------------------------------------------------------------------------------!
! Units a.u.:  Length 1 [a.u.] = 0.52917721067 [Angstrom];  Energy 1 [a.u.] = 27.2114 eV  !
!########################################################################################!

&calculation
    theory = 'sbe'
/

&control
    sysname = 'Si_epm'                     ! reads Si_epm_k.data / _eigen.data / _tm.data
/

&units
    unit_system = 'au'
/

&system
    yn_periodic = 'y'
    al(1:3) = 10.26d0, 10.26d0, 10.26d0
    nelec  = 32
    nstate = 32
/

&kgrid
    num_kgrid(1:3) = 4, 4, 4
/

&epm
    epm_material            = 'Si'        ! REQUIRED at SBE time: selects the Si
    epm_lattice_constant_au = 10.26d0     ! intervalley phonon table for yn_sbe_eph
/                                         ! (defaults to GaAs LO+5 otherwise!)

&tgrid
    dt = 0.05d0
    nt = 20000
/

&emfield
    ae_shape1      = 'Acos2'
    epdir_re1(1:3) = 0.0d0, 0.0d0, 1.0d0
    I_wcm2_1       = 1.0d+12                ! raise toward 1e13-1e14 for strong-field / II
    tw1            = 1000.0d0
    omega1         = 0.056d0
/

&sbe
    ! -------- Silicon super-compute mode (all channels are CPTP) --------
    yn_sbe_superres          = 'y'         ! ring-MPI Sigma^HF + nonlocal-partner II
    yn_sbe_eph               = 'y'         ! e-ph cooling (6 intervalley g/f phonons)
    sbe_eph_nu_sat           = 1.3d14      ! Si saturation rate [s^-1]  (Meng PRB 91, 075201)
    sbe_eph_temperature_k    = 300.0d0
    yn_sbe_eeh               = 'y'         ! carrier-carrier thermalization to a Fermi-Dirac
    yn_sbe_impact_ionization = 'y'         ! Keldysh soft (quadratic) threshold for Si
    sbe_ii_form              = 'keldysh_quadratic'
    sbe_ii_exponent          = 2
    sbe_ii_threshold_ev      = 1.1d0
    yn_sbe_bgr_threshold     = 'y'         ! density-dependent gap shrinkage shifts E_th
    sbe_decoh_temperature_k  = -1.0d0      ! Kuhn-Zurek off (e-ph provides decoherence)
/
