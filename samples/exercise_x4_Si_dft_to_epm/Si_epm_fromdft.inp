!########################################################################################!
! Silicon EPM ground state from DFT-FITTED local form factors.                            !
!----------------------------------------------------------------------------------------!
! Prerequisite: run run_dft_to_epm.sh first (DFT -> band.dat -> dft_to_epm.py), then copy !
! the produced 'Si_fromDFT_epm_formfactors.data' next to this input. This run reads that  !
! table (epm_material='file') instead of a built-in Cohen-Bergstresser set, and writes    !
! Si_epm_fromdft_k.data / _eigen.data / _tm.data in the usual EPM->SBE format.            !
!                                                                                         !
!   SALMON=/path/to/build/salmon  bash run_dft_to_epm.sh                                   !
!   cp work/Si_fromDFT_epm_formfactors.data .                                             !
!   $SALMON < Si_epm_fromdft.inp                                                          !
!########################################################################################!

&calculation
    theory = 'epm'
/

&control
    sysname = 'Si_epm_fromdft'
/

&units
    unit_system = 'au'
/

&system
    yn_periodic = 'y'
    al(1:3) = 10.2626d0, 10.2626d0, 10.2626d0   ! must match --a-lattice-au of the fit
    nelec  = 32
    nstate = 32
/

&kgrid
    num_kgrid(1:3) = 4, 4, 4
/

&epm
    epm_material            = 'file'                          ! read DFT-fitted factors
    epm_formfactor_file     = 'Si_fromDFT_epm_formfactors.data'
    epm_lattice_constant_au = 10.2626d0                       ! must match al(1:3)
    epm_pw_cutoff_ry        = 11.1d0
/
