!########################################################################################!
! Si DFT band path (step 2/3) -- theory='dft_band' on the FCC primitive cell.            !
!----------------------------------------------------------------------------------------!
! Restarts from the converged density of step 1 (data_for_restart/, read directly via    !
! directory_read_data -- no symlink needed) and diagonalizes H at the k-points along     !
! the high-symmetry path L - Gamma - X - W - L (4 segments x 16 = 64 = one 4x4x4 block). !
!                                                                                        !
!   ../../build/salmon < Si_dft_band.inp | tee dft_band.out                              !
!   cp band/Si_bandpath.data .            # co-locate with the SBE outputs for plotting  !
!                                                                                        !
! Outputs (in ./band/ -- base_directory is set so the path-k Si_k.data/Si_eigen.data     !
! do NOT overwrite the MP-grid files the SBE reads!):                                    !
!   band/Si_bandpath.data  -- the plotter/SBE-spectral contract (# spinor/nv/nb/nodes    !
!                             + rows: ik dist q1 q2 q3 E_1..E_nb [Ha])                   !
!   band.dat               -- legacy dft_band listing (cwd)                              !
! Plot: python3 ../../plot_sbe_results.py .   (picks up *_bandpath.data)                 !
!########################################################################################!

&calculation
  theory = 'dft_band'
/

&control
  sysname = 'Si'
  yn_restart = 'y'
  directory_read_data = './data_for_restart'
  base_directory = './band'
/

&units
  unit_system = 'A_eV_fs'
/

&system
  yn_periodic = 'y'
  al_vec1(1:3) = 0.0000000d0, 2.7146791d0, 2.7146791d0
  al_vec2(1:3) = 2.7146791d0, 0.0000000d0, 2.7146791d0
  al_vec3(1:3) = 2.7146791d0, 2.7146791d0, 0.0000000d0
  nelem  = 1
  natom  = 2
  nelec  = 8
  nstate = 12
/

&pseudo
  file_pseudo(1) = './Si_rps.dat'
  izatom(1) = 14
  lloc_ps(1) = 2
/

&functional
  xc = 'PZ'
/

&rgrid
  num_rgrid(1:3) = 12, 12, 12
/

&kgrid
  !array size of the wavefunction per band block; 4 segments x 16 = 64 = 4*4*4
  num_kgrid(1:3) = 4, 4, 4
/

&scf
  nscf      = 60
  threshold = 1.0d-6
/

&band
  !--- explicit path (lattice='non' => use kpt/ndiv_segment below) -------------!
  ! reduced coordinates of the FCC-primitive reciprocal basis (b1,b2,b3)        !
  lattice = 'non'
  nref_band = 12                       ! converge eigenvalues up to this band
  tol_esp_diff = 1.0d-4                ! rough per-band tolerance (a.u.)
  num_of_segments = 4                  ! L-G-X-W-L
  ndiv_segment(1:4) = 16, 16, 16, 16
  kpt(1:3,1) = 0.5d0,  0.5d0,  0.5d0   ! L
  kpt(1:3,2) = 0.0d0,  0.0d0,  0.0d0   ! Gamma
  kpt(1:3,3) = 0.5d0,  0.0d0,  0.5d0   ! X
  kpt(1:3,4) = 0.5d0,  0.25d0, 0.75d0  ! W
  kpt(1:3,5) = 0.5d0,  0.5d0,  0.5d0   ! L
  kpt_label(1) = 'L'
  kpt_label(2) = 'G'
  kpt_label(3) = 'X'
  kpt_label(4) = 'W'
  kpt_label(5) = 'L'
/

&atomic_red_coor
  'Si'  .0    .0    .0    1
  'Si'  .25   .25   .25   1
/
