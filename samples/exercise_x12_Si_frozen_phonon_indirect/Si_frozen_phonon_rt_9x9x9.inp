!########################################################################################!
! Si SBE (step 2/2) -- FROZEN-CORE 2V+2C + phonon-assisted INDIRECT -- 9x9x9 PRODUCTION.     !
!----------------------------------------------------------------------------------------!
! Identical physics to Si_frozen_phonon_rt.inp; the ONLY change is num_kgrid = 9,9,9. At      !
! 9^3 the indirect X-valley shell is resolved (4^3 only samples it coarsely), so this is the  !
! grid for the Keldysh-bracket verdict (rate_benchmark.py / calibration_scan.py).            !
!                                                                                          !
! nelec / nstate / al MUST match the GS step (Si_prim_epm_gs_9x9x9.inp) -- the SBE reads      !
! Si_prim_k/_eigen/_tm.data written there.                                                    !
!                                                                                          !
! eph ON  = this file.                                                                        !
! eph OFF = flip yn_sbe_eph -> 'n' AND yn_sbe_eph_acoustic -> 'n' (see the sbatch script,     !
!           which generates off_9.inp with sed). Keep everything else identical.              !
!----------------------------------------------------------------------------------------!
! MPI: 729 k-points are split across ranks by split_num (even +/-1; nproc need NOT divide     !
! 729). Use nproc <= 729; for perfect balance pick a divisor of 729 = 3^6 (27, 81, 243).      !
! electrons = 8.000 is conserved every step (frozen window + ring is trace-exact).            !
!########################################################################################!

&calculation
  theory = 'sbe'
/

&control
  sysname = 'Si_prim'
/

&units
  unit_system = 'au'
/

&system
  yn_periodic  = 'y'
  al(1:3) = 10.26d0, 10.26d0, 10.26d0
  nelec  = 8
  nstate = 16
/

&kgrid
  num_kgrid(1:3) = 9, 9, 9
/

&analysis
  out_projection_step   = 20      ! nex(t) cadence
  out_projection_k_step = 20      ! k-resolved real-carrier cadence (for the X-valley map)
/

&tgrid
  dt = 8.0d0
  nt = 400
/

&emfield
  ae_shape1      = 'Acos2'
  epdir_re1(1:3) = 0.0d0, 0.0d0, 1.0d0
  I_wcm2_1       = 1.0d+11        ! near-tunneling (Keldysh gamma ~ 1); basis-converged
  tw1            = 800.0d0
  omega1         = 0.0046d0       ! deep-IR (0.125 eV)
/

&epm
  epm_material = 'Si'
/

&sbe
  ! ---- FROZEN-CORE active window: 2 valence + 2 conduction at the gap edge ----
  frozen_core_threshold_ev = -3.0d0   ! keep the VBM doublet; freeze deeper valence
  frozen_free_threshold_ev =  6.0d0   ! keep CBM + next CB level; freeze higher conduction
  ! ---- dissipation: phonon-assisted indirect channel (+ momentum-resolved ring) ----
  yn_sbe_superres          = 'y'      ! ring: makes e-ph / II momentum-resolved (inter-k)
  yn_sbe_eph               = 'y'      ! <- set 'n' for the OFF reference
  yn_sbe_eph_acoustic      = 'y'      ! <- set 'n' for the OFF reference
  sbe_eph_temperature_k    = 300.0d0
  ! ---- optional: impact ionization + phonon-assisted II (verified trace-exact here) ----
  yn_sbe_impact_ionization = 'n'      ! set 'y' (with yn_sbe_ii_holes='y') to add II; electrons stay 8.000
  yn_sbe_ii_holes          = 'n'      ! set 'y' ONLY together with impact_ionization='y' (rides the ring)
  sbe_ii_phassist          = 1.0d0    ! phonon-assisted II weight (only used if II is on)
  yn_sbe_auger             = 'n'
  yn_sbe_eeh               = 'n'
  yn_sbe_coulomb           = 'n'
/
